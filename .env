# =====================================================
# ⚙️ APLIKASI
# =====================================================
APP_NAME="MalayaLand"
APP_ENV=local
APP_KEY=base64:h60Sd0PiCXyRxehW+02Kky3Plfa93F4bLem3uHbdLpY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =====================================================
# 🗄️ DATABASE
# =====================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=1-bester
DB_USERNAME=root
DB_PASSWORD=

# =====================================================
# 🪣 FILESYSTEM
# =====================================================
FILESYSTEM_DISK=public

# =====================================================
# 🧠 SESSION, CACHE, QUEUE
# =====================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# =====================================================
# 📨 MAIL (Gunakan Gmail App Password)
# =====================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@malayaland.com
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@malayaland.com

# =====================================================
# ☁️ REDIS (Optional)
# =====================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =====================================================
# 🌎 AWS (Optional - Kosongkan)
# =====================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =====================================================
# 🧩 FRONTEND VITE
# =====================================================
VITE_APP_NAME="${APP_NAME}"

# =====================================================
# 🔐 GOOGLE LOGIN (Opsional)
# =====================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback
